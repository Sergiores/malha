// Malha — schema de dados
//
// Convenções do projeto:
//  - PKs Int com autoincrement (evita a conversão manual que BigInt exige
//    ao serializar para JSON).
//  - createdAt/updatedAt em todas as tabelas.
//  - Índices em todas as FKs.
//
// Dois níveis que não devem ser confundidos: `Modulo` é o que se LICENCIA,
// `Calculadora` é o que se EXECUTA dentro dele.

generator client {
  provider        = "prisma-client-js"
  // Faz o Prisma resolver `include` com LATERAL JOIN em vez de uma query por
  // relação. Com o banco em sa-east-1 e as funções fora da região, cada
  // round-trip custa ~150 ms — juntar as queries é a otimização mais barata
  // que existe aqui.
  previewFeatures = ["relationJoins"]
  // "native" para o Windows local; "rhel-openssl-3.0.x" para as funções em
  // produção (Amazon Linux + OpenSSL 3). Sem o segundo, o PrismaClient lança
  // na importação e TODA server action devolve 500 — inclusive as que nem
  // tocam o banco, porque o módulo importa o client no topo.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// Conta — perfil do usuário
// ------------------------------------------------------------------
// A senha NÃO vive aqui: quem guarda hash e sessão é o Supabase Auth.
// `authUserId` é a ponte para `auth.users.id`.
model Conta {
  id         Int     @id @default(autoincrement())
  authUserId String? @unique @map("auth_user_id") @db.Uuid
  email      String? @unique
  nome       String?
  telefone   String?

  // Inativação por superadmin — quando false, o login é bloqueado em
  // requireConta(). Não apagamos contas com histórico.
  ativa Boolean @default(true)

  // Força a troca de senha no próximo acesso. Usado para a senha inicial
  // do superadmin, criada pelo seed.
  trocarSenha Boolean @default(false) @map("trocar_senha")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizacoes OrganizacaoMembro[]
  logs         LogAuditoria[]
  analises     Analise[]

  @@map("conta")
}

// ------------------------------------------------------------------
// Organizacao — a entidade que assina os módulos
// ------------------------------------------------------------------
// É quem contrata. O engenheiro autônomo é uma organização de um membro.
model Organizacao {
  id       Int     @id @default(autoincrement())
  nome     String
  cnpj     String? @unique
  telefone String?

  // Entrada de novos membros. O `id` é interno; quem entra usa este código
  // curto (Crockford Base32, sem caracteres ambíguos). Fixo, sem expiração.
  codigoConvite String @unique @map("codigo_convite")

  // Bloqueio comercial: false derruba o acesso de todos os membros,
  // independentemente das licenças de módulo.
  ativa Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  membros  OrganizacaoMembro[]
  modulos  OrganizacaoModulo[]
  analises Analise[]
  clientes Cliente[]

  @@map("organizacao")
}

enum PapelOrganizacao {
  ADMIN
  MEMBRO
}

// Vínculo N:N entre Conta e Organizacao, com papel.
model OrganizacaoMembro {
  id            Int              @id @default(autoincrement())
  idOrganizacao Int              @map("id_organizacao")
  idConta       Int              @map("id_conta")
  papel         PapelOrganizacao @default(MEMBRO)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizacao Organizacao @relation(fields: [idOrganizacao], references: [id], onDelete: Cascade)
  conta       Conta       @relation(fields: [idConta], references: [id], onDelete: Cascade)

  @@unique([idOrganizacao, idConta])
  @@index([idOrganizacao])
  @@index([idConta])
  @@map("organizacao_membro")
}

// ------------------------------------------------------------------
// Modulo — o que se LICENCIA
// ------------------------------------------------------------------
// Tabela, não enum: o superadmin precisa gerir sem deploy. As linhas são
// mantidas por sincronizarModulos() a partir de src/core/registry.ts.
model Modulo {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  nome      String
  descricao String?
  ordem     Int     @default(0)

  // Desativado quando some do registry. Nunca apagamos: licenças
  // históricas continuam apontando para cá.
  ativo Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  calculadoras Calculadora[]
  organizacoes OrganizacaoModulo[]

  @@map("modulo")
}

// ------------------------------------------------------------------
// Calculadora — o que se EXECUTA
// ------------------------------------------------------------------
// Vive dentro de um módulo. Nasce vazia: as calculadoras entram só quando
// as planilhas forem portadas.
model Calculadora {
  id        Int     @id @default(autoincrement())
  idModulo  Int     @map("id_modulo")
  slug      String  @unique
  nome      String
  descricao String?
  ordem     Int     @default(0)
  ativa     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  modulo   Modulo    @relation(fields: [idModulo], references: [id], onDelete: Cascade)
  analises Analise[]

  @@index([idModulo])
  @@map("calculadora")
}

// ------------------------------------------------------------------
// Cliente — para quem o serviço é prestado
// ------------------------------------------------------------------
// Pertence à organização: cada assinante enxerga só a própria carteira.
// O documento fica guardado só com dígitos (`cpfCnpj`), sem máscara — é o
// que permite buscar por "12345678000190" ou "12.345.678/0001-90" sem
// depender de como foi digitado.
model Cliente {
  id            Int @id @default(autoincrement())
  idOrganizacao Int @map("id_organizacao")

  nome     String
  cpfCnpj  String? @map("cpf_cnpj")
  endereco String?
  bairro   String?
  cidade   String?
  uf       String? @db.VarChar(2)
  cep      String? @db.VarChar(8)
  fone     String?
  email    String?
  contato  String?

  // Soft-delete: análises antigas continuam apontando para o cliente.
  ativo Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizacao Organizacao @relation(fields: [idOrganizacao], references: [id], onDelete: Cascade)
  analises    Analise[]

  // Documento único dentro da organização, não globalmente: duas empresas
  // podem ter o mesmo cliente em suas carteiras.
  @@unique([idOrganizacao, cpfCnpj])
  @@index([idOrganizacao, nome])
  @@index([idOrganizacao, cidade])
  @@map("cliente")
}

// ------------------------------------------------------------------
// Analise — um cálculo executado e guardado
// ------------------------------------------------------------------
// Entradas e resultados vão em Json de propósito: cada calculadora tem o
// seu formato, e engessar isso em colunas obrigaria a migrar o banco a cada
// calculadora nova. O contrato de cada Json vive no `schema.ts` do módulo
// correspondente em src/core/calculators/.
//
// O snapshot dos resultados é gravado junto: um laudo emitido em março tem
// de continuar mostrando os mesmos números em dezembro, mesmo que os preços
// de insumo ou a própria fórmula mudem no meio.
model Analise {
  id            Int  @id @default(autoincrement())
  idOrganizacao Int  @map("id_organizacao")
  idConta       Int  @map("id_conta")
  idCalculadora Int  @map("id_calculadora")
  // Opcional: a calculadora funciona sem cliente, e o módulo Geral pode não
  // estar licenciado. Vincular depois não perde nada.
  idCliente     Int? @map("id_cliente")

  titulo     String
  status     StatusAnalise @default(RASCUNHO)
  entradas   Json
  resultados Json
  observacao String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizacao Organizacao @relation(fields: [idOrganizacao], references: [id], onDelete: Cascade)
  conta       Conta       @relation(fields: [idConta], references: [id], onDelete: Cascade)
  calculadora Calculadora @relation(fields: [idCalculadora], references: [id], onDelete: Restrict)
  // SetNull, não Cascade: excluir um cliente não pode apagar os laudos que
  // já foram emitidos para ele.
  cliente     Cliente?    @relation(fields: [idCliente], references: [id], onDelete: SetNull)

  @@index([idCliente])
  @@index([idOrganizacao, createdAt])
  @@index([idConta])
  @@index([idCalculadora])
  @@map("analise")
}

enum StatusAnalise {
  RASCUNHO
  CONCLUIDA
  APROVADA
  ARQUIVADA
}

// ------------------------------------------------------------------
// OrganizacaoModulo — a LICENÇA
// ------------------------------------------------------------------
// O "vencimento dos módulos". Campos de assinatura (ciclo, valor, status
// de cobrança) entram aqui na fase do gateway, sem migração destrutiva.
model OrganizacaoModulo {
  id            Int @id @default(autoincrement())
  idOrganizacao Int @map("id_organizacao")
  idModulo      Int @map("id_modulo")

  validoDe  DateTime  @map("valido_de") @db.Date
  // null = sem prazo (licença vitalícia / cortesia).
  validoAte DateTime? @map("valido_ate") @db.Date

  // Revogação imediata sem mexer nas datas.
  ativo      Boolean @default(true)
  observacao String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizacao Organizacao @relation(fields: [idOrganizacao], references: [id], onDelete: Cascade)
  modulo      Modulo      @relation(fields: [idModulo], references: [id], onDelete: Cascade)

  @@unique([idOrganizacao, idModulo])
  @@index([idOrganizacao])
  @@index([idModulo])
  @@map("organizacao_modulo")
}

// ------------------------------------------------------------------
// LogAuditoria — quem concedeu ou revogou o quê, e quando
// ------------------------------------------------------------------
// Não é opcional em produto vendido: licença é dinheiro.
model LogAuditoria {
  id         Int    @id @default(autoincrement())
  idConta    Int?   @map("id_conta")
  acao       String
  entidade   String
  entidadeId Int?   @map("entidade_id")
  detalhes   Json?

  createdAt DateTime @default(now()) @map("created_at")

  conta Conta? @relation(fields: [idConta], references: [id], onDelete: SetNull)

  @@index([idConta])
  @@index([entidade, entidadeId])
  @@map("log_auditoria")
}
