# ==================================================================
# Malha — variáveis de ambiente
# Copie para .env e preencha. O .env NUNCA vai para o git.
# ==================================================================

# ------------------------------------------------------------------
# Banco de dados — Supabase (PostgreSQL)
# Painel: Project Settings -> Database -> Connection string
# ------------------------------------------------------------------
# DATABASE_URL -> "Transaction pooler" (porta 6543). Usada pelo app.
#                 Acrescente ?pgbouncer=true no final.
# DIRECT_URL   -> conexão direta / session (porta 5432). Usada só pelo
#                 Prisma Migrate — migration não funciona pelo pooler.
DATABASE_URL="postgresql://postgres.[ref]:[SENHA]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[SENHA]@aws-0-[regiao].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------
# Supabase — Auth
# Painel: Project Settings -> API
# ------------------------------------------------------------------
# As duas primeiras são públicas (vão para o browser).
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"

# SECRETA. Equivale a acesso administrativo total ao banco — usada só em
# server actions protegidas por requireSuperadmin(). Nunca importar em
# código que rode no browser.
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# ------------------------------------------------------------------
# Superadmin
# ------------------------------------------------------------------
# E-mail com acesso a /superadmin. Lido em runtime pelo guard.
SUPERADMIN_EMAIL="sergiorobertoesilva@gmail.com"

# Senha inicial — usada UMA vez pelo seed para criar a conta.
# Depois disso pode ficar vazia; a senha real vive no Supabase Auth.
SUPERADMIN_PASSWORD=""
